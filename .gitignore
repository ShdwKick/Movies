# Данные пользователей: комнаты, фильмы, оценки — не коммитить
data/

# Секреты для docker-compose.prod.yml (POISKKINO_API_KEY, ADMIN_INTERNAL_KEY) —
# подставляются через ${VAR:-}, живут только на сервере, права 600
.env

# Локальный запуск: свои базы auth и сервиса (node dev.mjs)
.dev/

# Артефакты ОС/редакторов
*.log
.DS_Store
Thumbs.db

# webtorrent (torrent-engine.js) — единственная npm-зависимость сервиса,
# ставится через package.json/package-lock.json, не коммитится
node_modules/
